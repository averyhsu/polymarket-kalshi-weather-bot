BOT_MODE=paper
BOT_PROFILE=balanced
DRY_RUN=false
VERBOSE=false

DB_PATH=kalshi_weather_bot.sqlite3
CACHE_DIR=.cache
HISTORICAL_DATA_DIR=historical_data/backtests
