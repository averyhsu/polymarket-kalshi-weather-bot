BOT_MODE=paper
BOT_PROFILE=balanced
DRY_RUN=false
VERBOSE=false

DB_PATH=kalshi_weather_bot.sqlite3
CACHE_DIR=.cache
HISTORICAL_DATA_DIR=historical_data/backtests
USER_AGENT=kalshi-weather-bot/1.0 (replace-with-your-contact)

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

ENABLED_CITIES=nyc,chicago,los_angeles,denver
BLACKLISTED_CITIES=miami
NO_ONLY=false
SKIP_SAME_DAY=true
DAY_AHEAD_ONLY=true

BOUNDARY_THRESHOLD=0.25
DISAGREEMENT_THRESHOLD=0.85
BOUNDARY_BUFFER_F=1.0
PSEUDO_COUNT=8.0
MIN_SIGMA_F=0.5

KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.02
MAX_POSITION_USD=10.0
FEE_PER_CONTRACT=0.01
SLIPPAGE_PER_CONTRACT=0.005

BASE_MIN_EV=0.04
MAX_SPREAD_CENTS=5
MIN_VOLUME=25
MIN_PRICE_CENTS=2
MAX_PRICE_CENTS=98

TAKE_PROFIT_CENTS=10
STOP_LOSS_CENTS=15
CLOSEOUT_HOURS_BEFORE=2
PROBABILITY_DRIFT_THRESHOLD=0.12
HOLD_MIN_EV=0.01

DAILY_MAX_LOSS_PCT=0.10
MAX_OPEN_POSITIONS=10
INITIAL_BALANCE=100.0
SURVIVAL_BALANCE_FLOOR=50.0
SURVIVAL_KELLY_FRACTION=0.10

FORECAST_CACHE_TTL_MINUTES=20
STALE_MARKET_MINUTES=20
SETTLEMENT_BUFFER_HOURS=8
SOURCE_HEALTH_TRADE_THRESHOLD=0.50
SOURCE_HEALTH_DEGRADED_THRESHOLD=0.75
